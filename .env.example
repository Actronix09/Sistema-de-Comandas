# Copiar a .env (no se sube a git) y cambiar la contraseña
COMANDAS_BD_USUARIO=comandas
COMANDAS_BD_CONTRASENA=cambiar-esta-contrasena

# Carpeta sql/ del repo de la base de datos
COMANDAS_SQL=../Bases de Datos/desarrollo-proyecto/sql

# Usuarios de la base con permisos limitados (sql/carga/crear_usuarios.sql).
# El servidor entra como app_comandas; consulta_comandas solo puede leer.
COMANDAS_APP_CLAVE=cambiar-esta-contrasena-app
COMANDAS_CONSULTA_CLAVE=cambiar-esta-contrasena-consulta
COMANDAS_ADMIN_CLAVE=cambiar-esta-contrasena-admin

# Páginas web que pueden conectarse al servidor, separadas por comas
COMANDAS_ORIGENES=https://actronix09.github.io
